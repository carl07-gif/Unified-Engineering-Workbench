{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run Unified Engineering Workbench",
            "type": "shell",
            "command": "cmd.exe /c Launch.bat",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [],
            "inAgents": true,
            "runOptions": {
                "runOn": "worktreeCreated"
            }
        },
        {
            "label": "Run All 49 C++ Unit Tests",
            "type": "shell",
            "command": "cmd.exe /c workbench_tests.exe",
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "problemMatcher": []
        },
        {
            "label": "Run Multicore Benchmark (1,000 Cases)",
            "type": "shell",
            "command": "cmd.exe /c workbench_backend.exe --benchmark 1000 40",
            "group": "none",
            "problemMatcher": []
        },
        {
            "label": "Run Extended Benchmark (10,000 Cases)",
            "type": "shell",
            "command": "cmd.exe /c workbench_backend.exe --benchmark 10000 40",
            "group": "none",
            "problemMatcher": []
        },
        {
            "label": "CMake: Configure",
            "type": "process",
            "command": "cmake",
            "args": [
                "-S",
                "${workspaceFolder}",
                "-B",
                "${workspaceFolder}\\build"
            ],
            "problemMatcher": []
        },
        {
            "label": "CMake: Build All",
            "type": "process",
            "command": "cmake",
            "args": [
                "--build",
                "${workspaceFolder}\\build",
                "--config",
                "Release"
            ],
            "dependsOn": "CMake: Configure",
            "group": "build",
            "problemMatcher": []
        }
    ]
}
