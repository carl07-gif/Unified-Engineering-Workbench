# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Explicit text files
*.cpp text eol=lf
*.hpp text eol=lf
*.h text eol=lf
*.c text eol=lf
*.cs text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.csv text eol=lf
*.stl text eol=lf
CMakeLists.txt text eol=lf

# Windows batch files must have CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.exe binary
*.dll binary
*.zip binary
*.bundle binary

